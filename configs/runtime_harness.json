{
  "version": "runtime-harness-1",
  "purpose": "Constructed operational diagnostics; not a clinical benchmark or training set.",
  "cases": [
    {"id": "role-inversion", "a": {"source": "Age >= 18 years", "comparator": ">=", "value": 18}, "b": {"source": "Age >= 18 years", "comparator": ">=", "value": 18, "criterion_type": "exclusion"}, "expected_label": "contradictory_or_disjoint", "must_escalate": false},
    {"id": "a-restrictive", "a": {"source": "Age >= 21 years", "comparator": ">=", "value": 21}, "b": {"source": "Age >= 18 years", "comparator": ">=", "value": 18}, "expected_label": "a_more_restrictive", "must_escalate": false},
    {"id": "b-restrictive", "a": {"source": "Age >= 18 years", "comparator": ">=", "value": 18}, "b": {"source": "Age >= 21 years", "comparator": ">=", "value": 21}, "expected_label": "b_more_restrictive", "must_escalate": false},
    {"id": "equivalent", "a": {"source": "Age >= 18 years", "comparator": ">=", "value": 18}, "b": {"source": "Age >= 18 years", "comparator": ">=", "value": 18}, "expected_label": "equivalent", "must_escalate": false},
    {"id": "partial-overlap", "a": {"source": "Age <= 65 years", "comparator": "<=", "value": 65}, "b": {"source": "Age >= 50 years", "comparator": ">=", "value": 50}, "expected_label": "partial_overlap", "must_escalate": false},
    {"id": "strict-endpoint", "a": {"source": "Age >= 18 years", "comparator": ">=", "value": 18}, "b": {"source": "Age > 18 years", "comparator": ">", "value": 18}, "expected_label": "b_more_restrictive", "must_escalate": false},
    {"id": "time-not-aligned", "a": {"source": "Age >= 18 years at consent", "comparator": ">=", "value": 18, "temporal": "at consent"}, "b": {"source": "Age >= 18 years at screening", "comparator": ">=", "value": 18, "temporal": "at screening"}, "expected_label": null, "must_escalate": true},
    {"id": "undefined-exception", "a": {"source": "Age >= 18 years unless an exception is granted", "comparator": ">=", "value": 18}, "b": {"source": "Age >= 18 years", "comparator": ">=", "value": 18}, "expected_label": null, "must_escalate": true},
    {"id": "source-comparator-conflict", "a": {"source": "Age >= 18 years", "comparator": ">", "value": 18}, "b": {"source": "Age > 18 years", "comparator": ">", "value": 18}, "expected_label": null, "must_escalate": true},
    {"id": "negation-not-proof", "a": {"source": "Age >= 18 years", "comparator": ">=", "value": 18}, "b": {"source": "Age >= 18 years", "comparator": ">=", "value": 18, "negated": true}, "expected_label": null, "must_escalate": true},
    {"id": "invalid-allowed-domain", "a": {"source": "Age < 0 years", "comparator": "<", "value": 0}, "b": {"source": "Age >= 18 years", "comparator": ">=", "value": 18}, "expected_label": null, "must_escalate": true},
    {"id": "exact-unit-conversion", "a": {"entity": "Hemoglobin", "source": "Hemoglobin >= 100 g/L", "comparator": ">=", "value": 100, "unit": "g/L"}, "b": {"entity": "Hemoglobin", "source": "Hemoglobin >= 8 g/dL", "comparator": ">=", "value": 8, "unit": "g/dL"}, "expected_label": "a_more_restrictive", "must_escalate": false}
  ]
}
