{
  "version": "runtime-harness-2",
  "purpose": "Constructed operational diagnostics; not a clinical benchmark or training set.",
  "cases": [
    {
      "id": "role-inversion",
      "a": {
        "source": "Age >= 18 years",
        "comparator": ">=",
        "value": 18
      },
      "b": {
        "source": "Age >= 18 years",
        "comparator": ">=",
        "value": 18,
        "criterion_type": "exclusion"
      },
      "expected_label": "contradictory_or_disjoint",
      "must_escalate": false
    },
    {
      "id": "a-restrictive",
      "a": {
        "source": "Age >= 21 years",
        "comparator": ">=",
        "value": 21
      },
      "b": {
        "source": "Age >= 18 years",
        "comparator": ">=",
        "value": 18
      },
      "expected_label": "a_more_restrictive",
      "must_escalate": false
    },
    {
      "id": "b-restrictive",
      "a": {
        "source": "Age >= 18 years",
        "comparator": ">=",
        "value": 18
      },
      "b": {
        "source": "Age >= 21 years",
        "comparator": ">=",
        "value": 21
      },
      "expected_label": "b_more_restrictive",
      "must_escalate": false
    },
    {
      "id": "equivalent",
      "a": {
        "source": "Age >= 18 years",
        "comparator": ">=",
        "value": 18
      },
      "b": {
        "source": "Age >= 18 years",
        "comparator": ">=",
        "value": 18
      },
      "expected_label": "equivalent",
